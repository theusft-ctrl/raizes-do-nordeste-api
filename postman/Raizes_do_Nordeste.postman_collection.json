  "item": [
    {
      "name": "1. Auth & Segurança",
      "item": [
        {
          "name": "T01 - Auth/Login válido (Cliente) -> 200 OK + accessToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('tokenCliente', jsonData.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria.cliente@exemplo.com\",\n  \"senha\": \"Cliente@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "T01b - Auth/Login válido (Gerente) -> 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",

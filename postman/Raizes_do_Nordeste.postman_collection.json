    "name": "Rede Raízes do Nordeste — API Back-End (UNINTER 2026 - RU 5057317)",
    "description": "Coleção oficial de testes da API RESTful Raízes do Nordeste cobrindo os 12 cenários obrigatórios (T01 a T12): Autenticação JWT, RBAC (401/403), Validação de Contrato e Multicanalidade (canalPedido), Controle de Estoque, Pagamento Mock (Aprovado/Recusado), Fidelidade e Auditoria LGPD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "tokenGerente",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": "1"
    }
